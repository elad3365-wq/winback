# WinBack — environment variables
# Copy this file to .env.local and fill in the values from your Supabase project
# (Supabase dashboard > Project Settings > API).
#
# Both values below are safe to expose in the browser. Do NOT put the service
# role key in this file or anywhere in the app: it bypasses Row Level Security.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The "anon" / publishable key (starts with "eyJ" or "sb_publishable_")
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of this app, used to build the email confirmation link.
# Optional. Only used when NOT deployed on Vercel, where the real domain is
# detected automatically. For local development leave this as-is.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Anthropic API key for the AI follow-up drafting feature.
# SERVER-ONLY. No NEXT_PUBLIC_ prefix, so it never reaches the browser — it is
# read only inside the /api/leads/[leadId]/ai-followup route on the server.
# Get one at https://console.anthropic.com > API Keys. Leave blank to disable
# the feature (the button then returns a clear "AI is not configured" message).
ANTHROPIC_API_KEY=
